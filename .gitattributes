# Auto detect text files and perform LF normalization
* text=auto

# Android and Kotlin specific files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.md text eol=lf

# Image and media files are binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
